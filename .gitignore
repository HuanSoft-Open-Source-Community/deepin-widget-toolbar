# Build directories
/build/
/build-tests/
/CMakeFiles/

# Local-only test harness and probe tools: deliberately untracked, and no
# longer referenced by the shipped build at all. The regression tests configure
# as their own out-of-tree project:
#   cmake -S tests/panelavoidwatcher -B build-tests && cmake --build build-tests
/tests/
/tools/

# AI agent tooling artifacts
/.reasonix/
/AGENTS.md

# Compiled translation files
*.qm

# Editor / IDE
*.user

# temp files
/.tmp/

# Debian packaging artifacts
/dist/
/debian/files
/debian/*.debhelper*
/debian/debhelper-build-stamp
/debian/*.substvars
/debian/deepin-widget-toolbar/
