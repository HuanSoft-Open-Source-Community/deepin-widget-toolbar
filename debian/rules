export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

# CMAKE_MESSAGE_LOG_LEVEL=WARNING 只保留 warning/error 级别的 CMake 输出：
# Qt6 的 CMake 配置在探测 XCB 时会打印三十余行 "Could NOT find XCB_*"，那是
# STATUS 提示（本项目不直接用 XCB），看起来像报错但并非错误。
override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DCMAKE_MESSAGE_LOG_LEVEL=WARNING
