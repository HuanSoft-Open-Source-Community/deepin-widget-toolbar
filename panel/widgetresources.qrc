<RCC>
    <qresource prefix="/widgets">
        <!-- 内置示例小组件（源文件在 package/widgets/ 下，随插件一并安装） -->
        <file alias="components/WidgetCard.qml">package/widgets/components/WidgetCard.qml</file>
        <file alias="components/AnalogClock.qml">package/widgets/components/AnalogClock.qml</file>
        <file alias="components/ColorUtils.qml">package/widgets/components/ColorUtils.qml</file>
        <file alias="components/qmldir">package/widgets/components/qmldir</file>
        <file alias="clock/main.qml">package/widgets/clock/main.qml</file>
        <file alias="clock/manifest.json">package/widgets/clock/manifest.json</file>
        <file alias="calendar/main.qml">package/widgets/calendar/main.qml</file>
        <file alias="calendar/manifest.json">package/widgets/calendar/manifest.json</file>
        <file alias="systemmonitor/main.qml">package/widgets/systemmonitor/main.qml</file>
        <file alias="systemmonitor/manifest.json">package/widgets/systemmonitor/manifest.json</file>
        <file alias="todo/main.qml">package/widgets/todo/main.qml</file>
        <file alias="todo/manifest.json">package/widgets/todo/manifest.json</file>
        <file alias="worldtime/main.qml">package/widgets/worldtime/main.qml</file>
        <file alias="worldtime/manifest.json">package/widgets/worldtime/manifest.json</file>
        <file alias="lyrics/main.qml">package/widgets/lyrics/main.qml</file>
        <file alias="lyrics/manifest.json">package/widgets/lyrics/manifest.json</file>
        <file alias="player/main.qml">package/widgets/player/main.qml</file>
        <file alias="player/manifest.json">package/widgets/player/manifest.json</file>
        <file alias="player/icons/prev-light.svg">package/widgets/player/icons/prev-light.svg</file>
        <file alias="player/icons/prev-dark.svg">package/widgets/player/icons/prev-dark.svg</file>
        <file alias="player/icons/play-light.svg">package/widgets/player/icons/play-light.svg</file>
        <file alias="player/icons/play-dark.svg">package/widgets/player/icons/play-dark.svg</file>
        <file alias="player/icons/pause-light.svg">package/widgets/player/icons/pause-light.svg</file>
        <file alias="player/icons/pause-dark.svg">package/widgets/player/icons/pause-dark.svg</file>
        <file alias="player/icons/next-light.svg">package/widgets/player/icons/next-light.svg</file>
        <file alias="player/icons/next-dark.svg">package/widgets/player/icons/next-dark.svg</file>
        <file alias="player/icons/music-light.svg">package/widgets/player/icons/music-light.svg</file>
        <file alias="player/icons/music-dark.svg">package/widgets/player/icons/music-dark.svg</file>
        <file alias="player/icons/na-light.svg">package/widgets/player/icons/na-light.svg</file>
        <file alias="player/icons/na-dark.svg">package/widgets/player/icons/na-dark.svg</file>
        <file alias="spectrum/main.qml">package/widgets/spectrum/main.qml</file>
        <file alias="spectrum/manifest.json">package/widgets/spectrum/manifest.json</file>
    </qresource>
</RCC>
