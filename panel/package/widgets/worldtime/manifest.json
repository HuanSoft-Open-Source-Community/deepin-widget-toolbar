{
    "id": "worldtime",
    "name": "World Time",
    "name[zh_CN]": "世界时间",
    "description": "World clock for multiple cities",
    "description[zh_CN]": "多城市世界时钟小组件",
    "version": "1.0.0",
    "apiVersion": "1.2",
    "author": "deepin-widget-toolbar",
    "icon": "preferences-system-time",
    "runtime": "qml",
    "entry": "main.qml",
    "defaultSize": { "cols": 2, "rows": 2 },
    "sizes": [
        { "cols": 1, "rows": 1 },
        { "cols": 2, "rows": 2 },
        { "cols": 4, "rows": 2 },
        { "cols": 4, "rows": 4 }
    ],
    "settings": [
        {
            "key": "clockMode",
            "type": "enum",
            "label": "Clock mode",
            "label[zh_CN]": "时钟模式",
            "default": "digital",
            "options": [
                { "value": "digital", "label": "Digital", "label[zh_CN]": "数字" },
                { "value": "analog", "label": "Analog", "label[zh_CN]": "指针" }
            ]
        },
        {
            "key": "dials",
            "type": "timezoneList",
            "label": "Dials",
            "label[zh_CN]": "表盘",
            "default": []
        },
        {
            "key": "showLabels",
            "type": "boolean",
            "label": "Show dial labels",
            "label[zh_CN]": "显示表盘标签",
            "default": true
        },
        {
            "key": "highlightLocal",
            "type": "boolean",
            "label": "Highlight local time",
            "label[zh_CN]": "高亮本机时间",
            "default": true
        }
    ],
    "builtin": true
}
