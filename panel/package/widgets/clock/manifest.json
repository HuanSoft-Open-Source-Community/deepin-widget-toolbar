{
    "id": "clock",
    "name": "Clock",
    "name[zh_CN]": "时钟",
    "description": "A digital clock widget",
    "description[zh_CN]": "数字时钟小组件",
    "version": "1.0.0",
    "apiVersion": "1.2",
    "author": "deepin-widget-toolbar",
    "icon": "appointment-new",
    "runtime": "qml",
    "entry": "main.qml",
    "defaultSize": { "cols": 2, "rows": 2 },
    "sizes": [
        { "cols": 1, "rows": 1 },
        { "cols": 2, "rows": 2 },
        { "cols": 4, "rows": 2 },
        { "cols": 4, "rows": 4 }
    ],
    "settings": [
        {
            "key": "clockMode",
            "type": "enum",
            "label": "Clock mode",
            "label[zh_CN]": "时钟模式",
            "default": "digital",
            "options": [
                { "value": "digital", "label": "Digital", "label[zh_CN]": "数字" },
                { "value": "analog", "label": "Analog", "label[zh_CN]": "指针" }
            ]
        },
        {
            "key": "preloadTime",
            "type": "boolean",
            "label": "Preload time mode",
            "label[zh_CN]": "预加载时间模式",
            "default": true
        }
    ],
    "builtin": true
}
