{
    "id": "todo",
    "name": "Sticky Note",
    "name[zh_CN]": "便签",
    "description": "A sticky note widget with per-instance data",
    "description[zh_CN]": "便签小组件，数据按实例隔离持久化",
    "version": "1.0.0",
    "apiVersion": "1.2",
    "author": "deepin-widget-toolbar",
    "icon": "edit-paste",
    "runtime": "qml",
    "entry": "main.qml",
    "defaultSize": { "cols": 2, "rows": 2 },
    "sizes": [
        { "cols": 2, "rows": 2 },
        { "cols": 4, "rows": 2 },
        { "cols": 4, "rows": 4 }
    ],
    "settings": [
        {
            "key": "transparentBackground",
            "type": "boolean",
            "label": "Transparent background",
            "label[zh_CN]": "透明背景",
            "default": false
        },
        {
            "key": "noteFontScale",
            "type": "enum",
            "label": "Note font size",
            "label[zh_CN]": "便签字号",
            "default": "medium",
            "options": [
                { "value": "small", "label": "Small", "label[zh_CN]": "小" },
                { "value": "medium", "label": "Medium", "label[zh_CN]": "中" },
                { "value": "large", "label": "Large", "label[zh_CN]": "大" }
            ]
        },
        {
            "key": "autoSaveInterval",
            "type": "enum",
            "label": "Auto-save interval",
            "label[zh_CN]": "自动保存间隔",
            "default": 5000,
            "options": [
                { "value": 2000, "label": "2 s", "label[zh_CN]": "2 秒" },
                { "value": 5000, "label": "5 s", "label[zh_CN]": "5 秒" },
                { "value": 10000, "label": "10 s", "label[zh_CN]": "10 秒" }
            ]
        },
        {
            "key": "textColor",
            "type": "color",
            "label": "Text color",
            "label[zh_CN]": "文字颜色",
            "default": "#3d2b00",
            "options": [
                { "value": "#3d2b00", "label": "Default", "label[zh_CN]": "默认" }
            ]
        },
        {
            "key": "titleBackgroundColor",
            "type": "color",
            "label": "Title background",
            "label[zh_CN]": "标题背景",
            "default": "#c8a500",
            "options": [
                { "value": "#c8a500", "label": "Default", "label[zh_CN]": "默认" }
            ]
        },
        {
            "key": "titleTextColor",
            "type": "color",
            "label": "Title text",
            "label[zh_CN]": "标题文字",
            "default": "#1a1a00",
            "options": [
                { "value": "#1a1a00", "label": "Default", "label[zh_CN]": "默认" }
            ]
        },
        {
            "key": "contentBackgroundColor",
            "type": "color",
            "label": "Content background",
            "label[zh_CN]": "内容背景",
            "default": "#fff8d6",
            "options": [
                { "value": "#fff8d6", "label": "Default", "label[zh_CN]": "默认" }
            ]
        },
        {
            "key": "lineColor",
            "type": "color",
            "label": "Line color",
            "label[zh_CN]": "行底线",
            "default": "#cccccc",
            "options": [
                { "value": "#cccccc", "label": "Default", "label[zh_CN]": "默认" }
            ]
        }
    ],
    "builtin": true
}
