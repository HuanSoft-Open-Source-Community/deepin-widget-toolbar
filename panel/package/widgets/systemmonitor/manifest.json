{
    "id": "systemmonitor",
    "name": "System Monitor",
    "name[zh_CN]": "资源监视仪表",
    "description": "CPU / memory / disk usage widget",
    "description[zh_CN]": "CPU / 内存 / 磁盘占用小组件",
    "version": "1.0.0",
    "apiVersion": "1.2",
    "author": "deepin-widget-toolbar",
    "icon": "utilities-system-monitor",
    "runtime": "qml",
    "entry": "main.qml",
    "defaultSize": { "cols": 2, "rows": 2 },
    "sizes": [
        { "cols": 2, "rows": 2 },
        { "cols": 4, "rows": 2 },
        { "cols": 4, "rows": 4 }
    ],
    "settings": [
        {
            "key": "showCpu",
            "type": "boolean",
            "label": "Show CPU",
            "label[zh_CN]": "显示 CPU",
            "default": true
        },
        {
            "key": "showMem",
            "type": "boolean",
            "label": "Show memory",
            "label[zh_CN]": "显示内存",
            "default": true
        },
        {
            "key": "showDisk",
            "type": "boolean",
            "label": "Show disk IO",
            "label[zh_CN]": "显示磁盘 IO",
            "default": true
        },
        {
            "key": "showGpu",
            "type": "boolean",
            "label": "Show GPU",
            "label[zh_CN]": "显示 GPU",
            "default": true
        },
        {
            "key": "showNpu",
            "type": "boolean",
            "label": "Show NPU",
            "label[zh_CN]": "显示 NPU",
            "default": true
        },
        {
            "key": "refreshInterval",
            "type": "enum",
            "label": "Refresh interval",
            "label[zh_CN]": "刷新间隔",
            "default": 1000,
            "options": [
                { "value": 500, "label": "0.5 s", "label[zh_CN]": "0.5 秒" },
                { "value": 1000, "label": "1 s", "label[zh_CN]": "1 秒" },
                { "value": 2000, "label": "2 s", "label[zh_CN]": "2 秒" },
                { "value": 5000, "label": "5 s", "label[zh_CN]": "5 秒" }
            ]
        }
    ],
    "builtin": true
}
