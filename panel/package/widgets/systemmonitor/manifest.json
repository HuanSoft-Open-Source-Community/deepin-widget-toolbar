{
    "id": "systemmonitor",
    "name": "System Monitor",
    "name[zh_CN]": "资源监视仪表",
    "description": "CPU / memory / disk / GPU / NPU usage widget",
    "description[zh_CN]": "CPU / 内存 / 磁盘 / GPU / NPU 占用小组件",
    "version": "1.0.0",
    "apiVersion": "1.3",
    "author": "deepin-widget-toolbar",
    "icon": "utilities-system-monitor",
    "runtime": "qml",
    "entry": "main.qml",
    "defaultSize": { "cols": 2, "rows": 2 },
    "sizes": [
        { "cols": 2, "rows": 2 },
        { "cols": 4, "rows": 2 },
        { "cols": 4, "rows": 4 }
    ],
    "settings": [
        {
            "key": "transparentBackground",
            "type": "boolean",
            "label": "Transparent background",
            "label[zh_CN]": "透明背景",
            "default": false
        },
        {
            "key": "showCpu",
            "type": "boolean",
            "label": "Show CPU",
            "label[zh_CN]": "显示 CPU",
            "default": true
        },
        {
            "key": "showMem",
            "type": "boolean",
            "label": "Show memory",
            "label[zh_CN]": "显示内存",
            "default": true
        },
        {
            "key": "showDisk",
            "type": "boolean",
            "label": "Show disk IO",
            "label[zh_CN]": "显示磁盘 IO",
            "default": true
        },
        {
            "key": "showGpu",
            "type": "boolean",
            "label": "Show GPU",
            "label[zh_CN]": "显示 GPU",
            "default": true
        },
        {
            "key": "showNpu",
            "type": "boolean",
            "label": "Show NPU",
            "label[zh_CN]": "显示 NPU",
            "default": true
        },
        {
            "key": "dualColumn",
            "type": "boolean",
            "label": "Dual-column mode",
            "label[zh_CN]": "双列模式",
            "default": true
        },
        {
            "key": "refreshInterval",
            "type": "enum",
            "label": "Refresh interval",
            "label[zh_CN]": "刷新间隔",
            "default": 5000,
            "options": [
                { "value": 1000, "label": "1 s", "label[zh_CN]": "1 秒" },
                { "value": 2000, "label": "2 s", "label[zh_CN]": "2 秒" },
                { "value": 5000, "label": "5 s", "label[zh_CN]": "5 秒" }
            ]
        },
        {
            "key": "backgroundColor",
            "type": "color",
            "label": "Background color",
            "label[zh_CN]": "背景颜色",
            "default": "#ff8b5cf6",
            "options": [
                { "value": "#ff8b5cf6", "label": "Default", "label[zh_CN]": "默认" }
            ]
        },
        {
            "key": "textColor",
            "type": "color",
            "label": "Text color",
            "label[zh_CN]": "文字颜色",
            "default": "#ffffff",
            "options": [
                { "value": "#ffffff", "label": "Default", "label[zh_CN]": "默认" }
            ]
        },
        {
            "key": "titleTextColor",
            "type": "color",
            "label": "Title text",
            "label[zh_CN]": "标题文字",
            "default": "#ffffff",
            "options": [
                { "value": "#ffffff", "label": "Default", "label[zh_CN]": "默认" }
            ]
        },
        {
            "key": "labelTextColor",
            "type": "color",
            "label": "Label text",
            "label[zh_CN]": "指标文字",
            "default": "#ffffff",
            "options": [
                { "value": "#ffffff", "label": "Default", "label[zh_CN]": "默认" }
            ]
        },
        {
            "key": "valueTextColor",
            "type": "color",
            "label": "Value text",
            "label[zh_CN]": "数值文字",
            "default": "#ffffff",
            "options": [
                { "value": "#ffffff", "label": "Default", "label[zh_CN]": "默认" }
            ]
        },
        {
            "key": "barTrackColor",
            "type": "color",
            "label": "Bar track",
            "label[zh_CN]": "进度条轨道",
            "default": "#ffffff",
            "options": [
                { "value": "#ffffff", "label": "Default", "label[zh_CN]": "默认" }
            ]
        },
        {
            "key": "barColor",
            "type": "color",
            "label": "Bar color",
            "label[zh_CN]": "进度条颜色",
            "default": "#4d8cff",
            "options": [
                { "value": "#4d8cff", "label": "Default", "label[zh_CN]": "默认" }
            ]
        }
    ],
    "builtin": true
}
